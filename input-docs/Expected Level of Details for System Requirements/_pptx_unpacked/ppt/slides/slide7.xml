<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Text Placeholder 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{6CDB54F0-074F-472D-9D81-43FE47216CB9}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="body" sz="quarter" idx="13"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="en-US" sz="2000" dirty="0"/><a:t>Test Station Capabilities</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="en-US" sz="1800" dirty="0"/><a:t>UUT part numbers to be covered by the Test Solution</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="en-US" sz="1800" dirty="0"/><a:t>Architecture to be used to meet testing needs</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="en-US" sz="1800" dirty="0"/><a:t>Adaptable: Provide provisions for growth, expansion, capability, and contraction to future system or system element capability.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="en-US" sz="1800" dirty="0"/><a:t>Functional and Environmental Capabilities including limits</a:t></a:r></a:p><a:p><a:pPr lvl="2"/><a:r><a:rPr lang="en-US" sz="1600" dirty="0"/><a:t>Temperature Chamber and associated limits</a:t></a:r></a:p><a:p><a:pPr lvl="3"/><a:r><a:rPr lang="en-US" sz="1400" dirty="0"><a:sym typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/></a:rPr><a:t>Test Station Shall include a thermal chamber that meet the specification below: </a:t></a:r></a:p><a:p><a:pPr lvl="4"/><a:r><a:rPr lang="en-US" sz="1400" dirty="0"><a:sym typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/></a:rPr><a:t>Internal normal temperature operating range from -55 C to +55 C, AND</a:t></a:r></a:p><a:p><a:pPr lvl="4"/><a:r><a:rPr lang="en-US" sz="1400" dirty="0"><a:sym typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/></a:rPr><a:t>External normal temperature operating range from -20 C to +40 C, AND</a:t></a:r></a:p><a:p><a:pPr lvl="4"/><a:r><a:rPr lang="en-US" sz="1400" dirty="0"><a:sym typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/></a:rPr><a:t>Minimum rate of temperature change of 10 C/min, AND  </a:t></a:r><a:r><a:rPr lang="en-US" sz="1400" dirty="0"/><a:t> </a:t></a:r></a:p><a:p><a:pPr lvl="4"/><a:r><a:rPr lang="en-US" sz="1400" dirty="0"/><a:t>Maximum power consumption XXXX watt, </a:t></a:r><a:r><a:rPr lang="en-US" sz="1400" dirty="0"><a:sym typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/></a:rPr><a:t>AND</a:t></a:r></a:p><a:p><a:pPr lvl="4"/><a:r><a:rPr lang="en-US" sz="1400" dirty="0"><a:sym typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/></a:rPr><a:t>Maximum normal operating current drawn XX Amp, AND</a:t></a:r></a:p><a:p><a:pPr lvl="4"/><a:r><a:rPr lang="en-US" sz="1400" dirty="0"><a:sym typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/></a:rPr><a:t>Maximum in rush current XX AMPs. </a:t></a:r><a:endParaRPr lang="en-US" sz="1400" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Text Placeholder 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{D0182E60-AB20-4B67-B447-52B4ADEE5179}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="body" sz="quarter" idx="17"/></p:nvPr></p: