<UserControl x:Class="TestCaseEditorApp.MVVM.Domains.Startup.Views.StartUp_MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F0EEE8">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20" MaxWidth="1240" HorizontalAlignment="Center">
                <Grid.Resources>
                    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#8A867D"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                    </Style>
                    <Style x:Key="ActionCardStyle" TargetType="Border">
                        <Setter Property="Background" Value="#FAFAF8"/>
                        <Setter Property="CornerRadius" Value="16"/>
                        <Setter Property="Padding" Value="20"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderBrush" Value="#E0DDD6"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                    <Style x:Key="UtilityCardStyle" TargetType="Border">
                        <Setter Property="Background" Value="#EAE7E0"/>
                        <Setter Property="CornerRadius" Value="14"/>
                        <Setter Property="Padding" Value="16"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderBrush" Value="#DDD7CD"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                    <Style x:Key="HeroPrimaryButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="#D15A14"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="18,8"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#B84F12"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="Root" Property="BorderBrush" Value="#1D2A3B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="TextLinkButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="#1D2A3B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#D15A14"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="#D15A14"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="ActionCardButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="#FAFAF8"/>
                        <Setter Property="BorderBrush" Value="#E0DDD6"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Foreground" Value="#1D2A3B"/>
                        <Setter Property="Padding" Value="20"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="16"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="#D15A14"/>
                                            <Setter TargetName="Root" Property="Background" Value="#FCFBF9"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Opacity" Value="0.93"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="#1D2A3B"/>
                                            <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Root" Property="Opacity" Value="0.6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="PrimaryActionCardButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionCardButtonStyle}">
                        <Setter Property="Background" Value="#1B2738"/>
                        <Setter Property="BorderBrush" Value="#1B2738"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Style>
                    <Style x:Key="LauncherActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionCardButtonStyle}">
                        <Setter Property="Width" Value="288"/>
                        <Setter Property="MinHeight" Value="160"/>
                        <Setter Property="Margin" Value="0,0,10,10"/>
                    </Style>
                    <Style x:Key="PrimaryLauncherActionButtonStyle" TargetType="Button" BasedOn="{StaticResource LauncherActionButtonStyle}">
                        <Setter Property="Background" Value="#1B2738"/>
                        <Setter Property="BorderBrush" Value="#1B2738"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Style>
                    <Style x:Key="RecentWorkshopCardButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionCardButtonStyle}">
                        <Setter Property="Width" Value="392"/>
                        <Setter Property="MinHeight" Value="156"/>
                        <Setter Property="Margin" Value="0,0,10,10"/>
                    </Style>
                </Grid.Resources>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Hero -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="REQUIREMENTS WORKSHOP"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Build, trace, and validate system requirements"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   Foreground="#1D2A3B"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Start a new workshop, resume active analysis, or import requirements from Jama."
                                   FontSize="14"
                                   Foreground="#646159"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Create Workshop"
                                    Command="{Binding CreateWorkshopCommand}"
                                    Style="{StaticResource HeroPrimaryButtonStyle}"
                                    Margin="0,0,14,0"
                                    />
                            <Button Content="Import from Jama"
                                    Command="{Binding ImportFromJamaCommand}"
                                    Style="{StaticResource TextLinkButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#F8F8F7"
                            BorderBrush="#E1DED6"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="CURRENT WORKSHOP PULSE"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="3" FontSize="30" FontWeight="SemiBold" Foreground="#1D2A3B"/>
                                    <TextBlock Text="OPEN WORKSHOPS" Style="{StaticResource SectionLabelStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="186" FontSize="30" FontWeight="SemiBold" Foreground="#1D2A3B"/>
                                    <TextBlock Text="REQUIREMENTS" Style="{StaticResource SectionLabelStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="5" FontSize="30" FontWeight="SemiBold" Foreground="#1D2A3B"/>
                                    <TextBlock Text="TRACE GAPS" Style="{StaticResource SectionLabelStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Start work cards -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="START WORK" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Command="{Binding CreateWorkshopCommand}"
                                Style="{StaticResource PrimaryLauncherActionButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="START HERE" Style="{StaticResource SectionLabelStyle}" Foreground="#B5C3D4"/>
                                <TextBlock Text="Create Workshop" FontSize="19" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,8,0,6"/>
                                <TextBlock Text="Start a structured workspace for a new requirement set." Foreground="#CBD5E2" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ImportFromJamaCommand}"
                                Style="{StaticResource LauncherActionButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="INGEST" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Text="Import Requirements" FontSize="19" FontWeight="SemiBold" Foreground="#1D2A3B" Margin="0,8,0,6"/>
                                <TextBlock Text="Bring in Jama items, documents, or source material." Foreground="#646159" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RunGapAnalysisCommand}"
                                Style="{StaticResource LauncherActionButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="ANALYZE" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Text="Run Gap Analysis" FontSize="19" FontWeight="SemiBold" Foreground="#1D2A3B" Margin="0,8,0,6"/>
                                <TextBlock Text="Check capability coverage and identify missing links." Foreground="#646159" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding GenerateTestCasesCommand}"
                                Style="{StaticResource LauncherActionButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="GENERATE" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Text="Generate Test Cases" FontSize="19" FontWeight="SemiBold" Foreground="#1D2A3B" Margin="0,8,0,6"/>
                                <TextBlock Text="Create verification-ready test scenarios from approved inputs." Foreground="#646159" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <!-- Recent workshops -->
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="RECENT WORKSHOPS" Style="{StaticResource SectionLabelStyle}"/>
                        <Button Grid.Column="1"
                                Content="View all"
                                Command="{Binding ViewAllWorkshopsCommand}"
                            Style="{StaticResource TextLinkButtonStyle}"
                            Foreground="#D15A14"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentWorkshops}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenRecentWorkshopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding FilePath}"
                                        Style="{StaticResource RecentWorkshopCardButtonStyle}"
                                        Padding="18"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="{Binding WorkshopName}" FontSize="17" FontWeight="SemiBold" Foreground="#1D2A3B" TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,6,0,8" Foreground="#8A867D" FontSize="12">
                                            <Run Text="{Binding SourceText}"/>
                                            <Run Text="   "/>
                                            <Run Text="{Binding LastUpdatedText}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="#646159" FontWeight="SemiBold" FontSize="12">
                                            <Run Text="Coverage "/>
                                            <Run Text="{Binding CoveragePercent}"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                        <ProgressBar Margin="0,5,0,9"
                                                     Height="5"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding CoveragePercent}"
                                                     Foreground="#2EAD8F"
                                                     Background="#DFD9CE"/>
                                        <TextBlock Foreground="#D15A14" FontWeight="SemiBold" FontSize="13" Text="Resume"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding EmptyRecentWorkshopsMessage}"
                               Foreground="#8A867D"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Utility status strip -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource UtilityCardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="JAMA CONNECTION" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="Connected to Project 686" FontSize="15" Foreground="#4E5A69" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource UtilityCardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="PROMPT QUALITY" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="3 templates improved this week" FontSize="15" Foreground="#4E5A69" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource UtilityCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SYSTEM HEALTH" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="All services available" FontSize="15" Foreground="#4E5A69" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>