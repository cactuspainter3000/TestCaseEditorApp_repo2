<UserControl x:Class="TestCaseEditorApp.MVVM.Domains.Requirements.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:TestCaseEditorApp.Converters"
             mc:Ignorable="d"
             MinHeight="400" MinWidth="800"
             Background="{StaticResource Brush.Background.Menu}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
        
        <!-- Style for staged requirement (bold, yellow background) -->
        <Style x:Key="StagedRequirementItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Primary}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StagedForCommit}" Value="True">
                    <Setter Property="Background" Value="#FFFFCC"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CommittedToJama}" Value="True">
                    <Setter Property="Foreground" Value="#999999"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
            <RowDefinition Height="*"/>
            <!-- Main content -->
            <RowDefinition Height="Auto"/>
            <!-- Action buttons -->
        </Grid.RowDefinitions>

        <!-- Status bar -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Background.Header}" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" 
                           Foreground="{StaticResource Brush.Accent.Primary}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                    <TextBlock Text="{Binding UnsavedCount, StringFormat=⚠️  {0} Unsaved}" 
                               Foreground="#FFA500" FontWeight="Bold"
                               Visibility="{Binding UnsavedCount, Converter={StaticResource BoolToVisibilityConverter}}"
                               Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding StagedCount, StringFormat=📋 {0} Staged}" 
                               Foreground="#4169E1" FontWeight="Bold"
                               Visibility="{Binding StagedCount, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content: Split view (list on left, detail on right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <!-- Splitter -->
                <ColumnDefinition Width="*"/>
                <!-- Detail pane -->
            </Grid.ColumnDefinitions>

            <!-- Left pane: Requirements list -->
            <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter toggle -->
                    <DockPanel Grid.Row="0" Margin="8" LastChildFill="True">
                        <Button DockPanel.Dock="Right" 
                                Command="{Binding ToggleStagedFilterCommand}"
                                Content="Filter" 
                                Padding="8,4" 
                                ToolTip="Show only staged requirements"/>
                        <TextBlock Text="Requirements" 
                                   Foreground="{StaticResource Brush.Accent.Primary}" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Requirements ListBox -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Requirements}"
                             SelectedItem="{Binding CurrentRequirement}"
                             ItemContainerStyle="{StaticResource StagedRequirementItemStyle}"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" 
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding JamaKey}" 
                                                   FontSize="11" 
                                                   Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Status indicators -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                                        <TextBlock Text="✎" 
                                                   Foreground="#FFA500"
                                                   FontSize="14"
                                                   Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   ToolTip="Has unsaved changes"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Text="📌" 
                                                   Foreground="#4169E1"
                                                   FontSize="14"
                                                   Visibility="{Binding StagedForCommit, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   ToolTip="Staged for commit"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Text="✓" 
                                                   Foreground="#008000"
                                                   FontSize="14"
                                                   Visibility="{Binding CommittedToJama, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   ToolTip="Committed to Jama"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                          Background="{StaticResource Brush.Border.Subtle}"/>

            <!-- Right pane: Detail editor -->
            <Border Grid.Column="2" Margin="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- No selection message -->
                    <TextBlock Grid.Row="0" Grid.RowSpan="3"
                               Text="Select a requirement to edit"
                               Foreground="#999999"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="{Binding CurrentRequirement, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=NOT}"/>

                    <!-- Requirement header -->
                    <StackPanel Grid.Row="0" Orientation="Vertical" 
                                Visibility="{Binding CurrentRequirement, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding CurrentRequirement.DisplayName}" 
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Accent.Primary}"/>
                        <TextBlock Text="{Binding CurrentRequirement.JamaKey}" 
                                   FontSize="12" Foreground="#666666"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Editing controls -->
                    <Grid Grid.Row="1" Margin="0,12,0,0"
                          Visibility="{Binding CurrentRequirement, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Name field -->
                        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="Name" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CurrentRequirement.CurrentName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4"/>
                        </StackPanel>

                        <!-- Action buttons -->
                        <Button Grid.Column="1" 
                                Command="{Binding ResetRequirementCommand}"
                                CommandParameter="{Binding CurrentRequirement}"
                                Content="Reset" Margin="8,0,0,0" Padding="8,4"
                                ToolTip="Discard all changes"/>

                        <CheckBox Grid.Column="2" Content="Stage" Margin="8,0,0,0"
                                  IsChecked="{Binding CurrentRequirement.StagedForCommit, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  ToolTip="Mark for commit to Jama"/>

                        <Button Grid.Column="3" 
                                Command="{Binding SaveCommand}"
                                Content="Save Changes" Margin="8,0,0,0" Padding="8,4"
                                ToolTip="Save to local workspace"/>

                        <Button Grid.Column="4" 
                                Command="{Binding LoadRequirementsCommand}"
                                Content="Refresh" Margin="8,0,0,0" Padding="8,4"
                                ToolTip="Reload from Jama"/>
                    </Grid>

                    <!-- Description field (large text editor) -->
                    <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,12,0,0"
                                Visibility="{Binding CurrentRequirement, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Description" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CurrentRequirement.CurrentDescription, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="6,4"
                                 MinHeight="150"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom action bar -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Background.Header}" Padding="8" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Info text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                    <TextBlock Text="{Binding Requirements.Count, StringFormat=📊 {0} Total}" 
                               Foreground="{StaticResource Brush.Accent.Primary}"
                               Margin="0,0,16,0"/>
                </StackPanel>

                <!-- LLM Analysis button -->
                <Button Grid.Column="1" 
                        Command="{Binding AnalyzeAllWithLlmCommand}"
                        Content="🤖 Analyze All with LLM"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        ToolTip="Run INCOSE + quality analysis on all requirements"/>

                <!-- Commit button -->
                <Button Grid.Column="2" 
                        Command="{Binding CommitStagedRequirementsCommand}"
                        Content="✅ Commit Staged Requirements"
                        Padding="12,6"
                        ToolTip="Commit all staged requirements back to Jama"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=NOT}"/>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.RowSpan="3" 
                Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                <TextBlock Text="Loading..." Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
