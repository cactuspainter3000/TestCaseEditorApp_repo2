<UserControl x:Class="TestCaseEditorApp.MVVM.Domains.Requirements.Views.RequirementsUtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:TestCaseEditorApp.Converters"
             mc:Ignorable="d"
             Background="{StaticResource Brush.Background.Menu}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Status bar -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Background.Header}" Padding="8">
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="{StaticResource Brush.Accent.Primary}"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel: Utility buttons -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,16,0">
                <TextBlock Text="Utilities" FontSize="16" FontWeight="Bold" 
                           Foreground="{StaticResource Brush.Accent.Primary}"
                           Margin="0,0,0,12"/>

                <!-- Probe Jama button -->
                <Button Command="{Binding ProbeJamaCommand}"
                        Content="🔍 Probe Jama Connection"
                        Padding="12,8"
                        Margin="0,0,0,8"
                        ToolTip="Test Jama API connectivity and configuration"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=NOT}"/>

                <!-- Export Logs button -->
                <Button Command="{Binding ExportLogsCommand}"
                        Content="📋 Export Logs"
                        Padding="12,8"
                        Margin="0,0,0,8"
                        ToolTip="Save application logs to Desktop"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=NOT}"/>

                <!-- Diagnostics button -->
                <Button Command="{Binding ShowDiagnosticsCommand}"
                        Content="🔧 Diagnostics"
                        Padding="12,8"
                        Margin="0,0,0,8"
                        ToolTip="Show system and application information"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=NOT}"/>

                <!-- Clear Workspace button -->
                <Button Command="{Binding ClearWorkspaceCommand}"
                        Content="🗑️  Clear Workspace"
                        Padding="12,8"
                        Margin="0,0,0,8"
                        Background="#8B0000"
                        Foreground="White"
                        ToolTip="Clear all edits and workspace data (cannot be undone)"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=NOT}"/>

                <Button Command="{Binding DeleteProject686CommonRequirementsFolderCommand}"
                    Content="⚠️ TEMP: Delete Project 686 Common Requirements Folder"
                    Padding="12,8"
                    Margin="0,0,0,8"
                    Background="#6A0000"
                    Foreground="White"
                    ToolTip="Temporary troubleshooting action: permanently delete folder 'Common Requirements' and all descendants in Jama project 686"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=NOT}"/>

                <!-- Clear Logs button -->
                <Button Command="{Binding ClearLogsCommand}"
                        Content="📝 Clear Output"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        ToolTip="Clear the log output display"/>

                <!-- Separator -->
                <Separator Margin="0,12" Background="{StaticResource Brush.Border.Subtle}"/>

                <!-- Delete Requirements section -->
                <TextBlock Text="Bulk Delete" FontSize="12" FontWeight="Bold" 
                           Foreground="{StaticResource Brush.Accent.Primary}"
                           Margin="0,12,0,8"/>

                <TextBlock Text="Delete IDs >"
                       Margin="0,0,0,4"
                       VerticalAlignment="Center"
                       Foreground="#BBBBBB"
                       FontSize="11"/>

                <TextBox Width="80"
                     Height="24"
                     Text="{Binding DeleteItemSuffixThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     Background="#1E1E1E"
                     Foreground="#DDDDDD"
                     BorderBrush="#555555"
                     BorderThickness="1"
                     ToolTip="Trailing numeric ID threshold for bulk delete"
                     Margin="0,0,0,8"/>

                <Button Command="{Binding DeleteRequirementsAboveThresholdCommand}"
                        Content="🗑️ Delete Matching"
                        Padding="12,8"
                        Margin="0,0,0,8"
                        Background="#8B0000"
                        Foreground="White"
                        ToolTip="Delete all requirements whose trailing numeric item/global ID is greater than the threshold"/>

                <!-- Deletion preview -->
                <TextBlock Text="Preview" FontSize="11" FontWeight="Bold" 
                           Foreground="#BBBBBB"
                           Margin="0,8,0,4"/>
                
                <TextBlock Text="{Binding DeletionPreviewStatus}" 
                           FontSize="10"
                           Foreground="#AFAFAF"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>

                <ListBox ItemsSource="{Binding DeletionPreviewItems}" 
                         Height="80"
                         Background="#1E1E1E"
                         BorderBrush="#555555"
                         BorderThickness="1"
                         FontSize="10"
                         Foreground="#DDDDDD"
                         Margin="0,0,0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="4,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Separator -->
                <Separator Margin="0,12" Background="{StaticResource Brush.Border.Subtle}"/>

                <!-- Loading indicator -->
                <StackPanel Orientation="Horizontal" 
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                           Margin="0,12,0,0">
                    <TextBlock Text="Working..." Foreground="#FFA500" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>

            <!-- Right panel: Log output -->
            <Border Grid.Column="1" 
                    Background="{StaticResource Brush.Background.Header}"
                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Output Log" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Accent.Primary}"
                               Margin="0,0,0,8"/>

                    <TextBox Grid.Row="1"
                             Text="{Binding LogOutput, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="6,4"
                             Foreground="#00AA00"
                             Background="#1E1E1E"
                             FontFamily="Courier New"
                             FontSize="11"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading overlay -->
        <Border Grid.RowSpan="2" 
                Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                <TextBlock Text="Processing..." Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
