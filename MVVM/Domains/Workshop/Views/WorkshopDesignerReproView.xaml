<UserControl x:Class="TestCaseEditorApp.MVVM.Domains.Workshop.Views.WorkshopDesignerReproView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TestCaseEditorApp.MVVM.Domains.Workshop.Views"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="760"
             Background="{StaticResource Brush.Background.Menu}">

    <UserControl.Resources>
        <!-- Slightly darker border for this view only - override app-level Brush.Border.Subtle -->
        <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#333333"/>
        
        <!-- Converters for modal panel -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        
        <!-- Converter for toggle button text -->
        <local:BoolToAnalysisButtonTextConverter x:Key="BoolToAnalysisButtonTextConverter"/>
        
        <!-- Converter for showing analysis results -->
        <local:HasAnalysisResultsConverter x:Key="HasAnalysisResultsConverter"/>
        
        <!-- Converters for requirement lifecycle state -->
        <local:LifecycleStageToDisplayConverter x:Key="LifecycleStageToDisplayConverter"/>
        <local:LifecycleStageToColorConverter x:Key="LifecycleStageToColorConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- Main content -->
        <TabControl Margin="12"
                Background="{StaticResource Brush.Background.Menu}"
                BorderThickness="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0"
                                  IsItemsHost="True"
                                  Background="{StaticResource Brush.Background.Menu}"
                                  Margin="0"/>
                        <ContentPresenter Grid.Row="1"
                                          ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.Resources>
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Background" Value="{StaticResource Brush.Background.Header}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Primary}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="20,8"/>
                <Setter Property="Margin" Value="0,0,2,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4,4,0,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Border.Focus}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="10"/>
                                    <Setter Property="Margin" Value="0,0,-2,0"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Border.Accent}"/>
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Background.Pill.Selected}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.Resources>
        <TabItem Header="Jama Object">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource Brush.Background.Menu}"
                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="6">
                    <Border Background="{StaticResource Brush.Background.Header}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="1"
                                    Background="{StaticResource Brush.Background.Menu}"
                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentObjectLabel, FallbackValue=Current Requirement}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <Button Content="{Binding StageToggleButtonText, FallbackValue=Click to Stage, TargetNullValue=Click to Stage}"
                                            Command="{Binding ToggleStageCommand}"
                                            Padding="12,5"
                                            MinWidth="220"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            BorderThickness="1"
                                            ToolTip="{Binding StageToggleToolTip}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{StaticResource Brush.Background.Pill.Selected}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Primary}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Accent}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StageToggleButtonText}" Value="Click to Edit">
                                                        <Setter Property="Background" Value="{StaticResource Brush.Background.Header}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Border Width="1"
                                            Height="20"
                                            Margin="8,0"
                                            Background="{StaticResource Brush.Border.Subtle}"
                                            VerticalAlignment="Center"/>
                                        <Button Content="Delete"
                                            Command="{Binding DeleteCurrentRequirementCommand}"
                                            Padding="10,5"
                                            MinWidth="88"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Background="{StaticResource Brush.Background.Header}"
                                            Foreground="{StaticResource Brush.State.Error}"
                                            BorderBrush="{StaticResource Brush.State.Error}"
                                            BorderThickness="1"
                                            ToolTip="Delete the currently selected item in the active tab."/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3"
                                    Background="{StaticResource Brush.Background.Menu}"
                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding StagedGlobalSummaryText, FallbackValue='Staged Requirements (0) and Test Cases (0)'}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="280"/>

                                    <Button Grid.Row="0"
                                            Grid.Column="2"
                                            Content="Commit"
                                            Command="{Binding CommitStagedCommand}"
                                            Padding="12,5"
                                            MinWidth="150"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Background="{StaticResource Brush.Background.Pill.Selected}"
                                            Foreground="{StaticResource Brush.Accent.Primary}"
                                            BorderBrush="{StaticResource Brush.Border.Accent}"
                                            BorderThickness="1"
                                            ToolTip="Commit all staged objects in the current workshop set."/>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="3"
                                               Margin="0,4,0,0"
                                               FontSize="10"
                                               Foreground="{StaticResource Brush.Text.Tertiary}"
                                               Text="No staged items to commit."
                                               Visibility="Collapsed">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StagedCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Border>

                <!-- Main workshop composition canvas - tabbed interface for Requirement/Test Case -->
                <TabControl Grid.Row="2"
                            Background="{StaticResource Brush.Background.Menu}"
                            BorderThickness="0"
                            SelectedIndex="{Binding ActiveObjectTabIndex, Mode=TwoWay}">
                    <TabControl.Resources>
                        <Style TargetType="{x:Type TabItem}">
                            <Setter Property="Background" Value="{StaticResource Brush.Background.Header}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Primary}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="20,8"/>
                            <Setter Property="Margin" Value="0,0,2,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4,4,0,0"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter x:Name="ContentSite"
                                                              ContentSource="Header"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Border.Focus}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Panel.ZIndex" Value="10"/>
                                                <Setter Property="Margin" Value="0,0,-2,0"/>
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Border.Accent}"/>
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Background.Pill.Selected}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- Requirement Tab -->
                    <TabItem Header="Requirement">
                        <Border
                            BorderBrush="{StaticResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Background="{StaticResource Brush.Background.Menu}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" x:Name="RequirementColumn"/>
                                <ColumnDefinition Width="0" x:Name="AnalysisPanelColumn"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Requirement Content -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="3*"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RequirementNameDisplay, FallbackValue='Requirement: (Name (not set))'}" 
                                           FontWeight="Bold"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Accent.Primary}"/>
                                
                                <!-- State Badge - color-coded by lifecycle stage -->
                                <Border Grid.Column="1"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8,3"
                                        Margin="12,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- Default: Unsaved (amber) -->
                                            <Setter Property="Background" Value="{StaticResource Brush.State.Warning}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.State.Warning}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentRequirementStage, Converter={StaticResource LifecycleStageToDisplayConverter}}" Value="Staged">
                                                    <Setter Property="Background" Value="{StaticResource Brush.Accent.Primary}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentRequirementStage, Converter={StaticResource LifecycleStageToDisplayConverter}}" Value="Committed">
                                                    <Setter Property="Background" Value="{StaticResource Brush.State.Success}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.State.Success}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding CurrentRequirementStage, Converter={StaticResource LifecycleStageToDisplayConverter}}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </Border>
                                
                                <Button Grid.Column="2"
                                        Content="{Binding IsAnalysisModalOpen, Converter={StaticResource BoolToAnalysisButtonTextConverter}}"
                                        Command="{Binding ToggleAnalysisModalCommand}"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Brush.Background.Pill.Selected}"
                                        Foreground="{StaticResource Brush.Accent.Primary}"
                                        BorderBrush="{StaticResource Brush.Border.Accent}"
                                        BorderThickness="1"/>
                            </Grid>

                            <Border Grid.Row="2"
                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="{StaticResource Brush.Background.Menu}"
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <WrapPanel Grid.Row="0">
                                        <Border Background="{StaticResource Brush.Background.Header}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="12" Margin="0,0,8,0" Padding="8,3">
                                            <TextBlock Text="{Binding CurrentRequirement.Item, StringFormat=Item ID: {0}, TargetNullValue=Item ID: (not set), FallbackValue=Item ID: (not set)}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11"/>
                                        </Border>
                                        <Border Background="{StaticResource Brush.Background.Header}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="12" Margin="0,0,8,0" Padding="8,3">
                                            <TextBlock Text="{Binding CurrentRequirement.GlobalId, StringFormat=Global ID: {0}, TargetNullValue=Global ID: (not set), FallbackValue=Global ID: (not set)}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11"/>
                                        </Border>
                                        <Border Background="{StaticResource Brush.Background.Header}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="12" Margin="0,0,8,0" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Status:" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Primary}" VerticalAlignment="Center"/>
                                                <TextBox Width="90" Text="{Binding CurrentRequirement.Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4,1" MinHeight="20" TextWrapping="NoWrap" Foreground="{StaticResource Brush.Text.Secondary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Subtle}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource Brush.Background.Header}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="12" Margin="0,0,8,0" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Req Type:" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Primary}" VerticalAlignment="Center"/>
                                                <TextBox Width="100" Text="{Binding CurrentRequirement.RequirementType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4,1" MinHeight="20" TextWrapping="NoWrap" Foreground="{StaticResource Brush.Text.Secondary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Subtle}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource Brush.Background.Header}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="12" Margin="0,0,8,0" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Export Controlled:" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Primary}" VerticalAlignment="Center"/>
                                                <TextBox Width="84" Text="{Binding CurrentRequirement.ExportControlled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4,1" MinHeight="20" TextWrapping="NoWrap" Foreground="{StaticResource Brush.Text.Secondary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Subtle}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource Brush.Background.Header}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="12" Margin="0,0,8,0" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Verification:" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Primary}" VerticalAlignment="Center"/>
                                                <TextBox Width="110" Text="{Binding CurrentRequirement.VerificationMethodRaw, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4,1" MinHeight="20" TextWrapping="NoWrap" Foreground="{StaticResource Brush.Text.Secondary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Subtle}"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="4" Padding="8" Background="{StaticResource Brush.Background.Header}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="6"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Description"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Accent.Primary}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1"
                                                            Content="Edit"
                                                            Command="{Binding OpenRequirementEditorCommand}"
                                                            Padding="8,2"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Background="{StaticResource Brush.Background.Pill.Selected}"
                                                            Foreground="{StaticResource Brush.Accent.Primary}"
                                                            BorderBrush="{StaticResource Brush.Border.Accent}"
                                                            BorderThickness="1"
                                                            ToolTip="Open full requirement editor (description + tables)."/>
                                                </Grid>

                                                <!-- View-only preview: double-click opens full editor modal -->
                                                <TextBox Grid.Row="2"
                                                         Text="{Binding CurrentRequirement.Description, TargetNullValue=(description), FallbackValue=(description)}"
                                                         IsReadOnly="True"
                                                         Cursor="Arrow"
                                                         FontWeight="SemiBold"
                                                         Foreground="{StaticResource Brush.Text.Primary}"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         Height="240"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Padding="6,4"
                                                         Background="{StaticResource Brush.Background.Menu}"
                                                         BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                         ToolTip="Double-click to edit this requirement in the modal editor.">
                                                    <TextBox.InputBindings>
                                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenRequirementEditorCommand}"/>
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2"
                                                BorderBrush="{StaticResource Brush.Border.Default}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8"
                                                Background="{StaticResource Brush.Background.Header}">
                                            <TabControl Background="{StaticResource Brush.Background.Header}"
                                                        BorderThickness="0">
                                                <TabItem Header="Compliance">
                                                    <Grid Margin="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="8"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="8"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SoC" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Brush.Accent.Primary}" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding CurrentRequirement.StatementOfCompliance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="5,2" MinHeight="22" TextWrapping="NoWrap" Foreground="{StaticResource Brush.Text.Secondary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Subtle}"/>

                                                        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="Compliance Rationale" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Brush.Accent.Primary}"/>
                                                        <TextBox Grid.Row="4" Grid.ColumnSpan="3" Margin="0,18,0,0" Text="{Binding CurrentRequirement.ComplianceRationale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="5,3" MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Foreground="{StaticResource Brush.Text.Secondary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Subtle}"/>
                                                    </Grid>
                                                </TabItem>

                                                <TabItem Header="Validation">
                                                    <Grid Margin="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="8"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="8"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Validation Method/s" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Brush.Accent.Primary}" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding CurrentRequirement.ValidationMethodRaw, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="5,2" MinHeight="22" TextWrapping="NoWrap" Foreground="{StaticResource Brush.Text.Secondary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Subtle}"/>

                                                        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="Validation Evidence" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Brush.Accent.Primary}"/>
                                                        <TextBox Grid.Row="4" Grid.ColumnSpan="3" Margin="0,18,0,0" Text="{Binding CurrentRequirement.ValidationEvidence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="5,3" MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Foreground="{StaticResource Brush.Text.Secondary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Subtle}"/>
                                                    </Grid>
                                                </TabItem>
                                            </TabControl>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="4"
                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="{StaticResource Brush.Background.Header}"
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Relationships" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Primary}"/>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,0,4" Text="Upstream" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Brush.Accent.Primary}"/>
                                        <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,0,0" Text="{Binding CurrentRequirement.UpstreamCrossInstanceRelationships, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinLines="1" MaxLines="20" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Padding="6,4" Foreground="{StaticResource Brush.Text.Secondary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Subtle}"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,0,4" Text="Downstream" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Brush.Accent.Primary}"/>
                                        <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,0,0" Text="{Binding CurrentRequirement.DownstreamCrossInstanceRelationships, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinLines="1" MaxLines="20" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Padding="6,4" Foreground="{StaticResource Brush.Text.Secondary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Subtle}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            </Grid>
                            
                            <!-- LLM Analysis Panel (right column) -->
                            <Border Grid.Column="1"
                                    Background="{StaticResource Brush.Background.Menu}"
                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                    BorderThickness="1,0,0,0"
                                    Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Header with Analyze and Close buttons -->
                                    <Border Grid.Row="0"
                                            Background="{StaticResource Brush.Background.Header}"
                                            BorderBrush="{StaticResource Brush.Border.Subtle}"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,8"
                                            Margin="-12,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="LLM Analysis Results"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="{StaticResource Brush.Accent.Primary}"/>
                                                <TextBlock Text="{Binding AnalysisStatusText}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource Brush.Text.Tertiary}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Analyze"
                                                        Command="{Binding LlmAnalyzeRequirementCommand}"
                                                        Margin="0,0,6,0"
                                                        Padding="8,3"
                                                        FontSize="11"
                                                        Background="{StaticResource Brush.Background.Pill.Selected}"
                                                        Foreground="{StaticResource Brush.Accent.Primary}"
                                                        BorderBrush="{StaticResource Brush.Border.Accent}"
                                                        BorderThickness="1"/>
                                                <Button Content="X"
                                                        Command="{Binding ToggleAnalysisModalCommand}"
                                                        FontSize="14"
                                                        Width="28"
                                                        Height="28"
                                                        Foreground="{StaticResource Brush.Text.Secondary}"
                                                        Background="Transparent"
                                                        BorderThickness="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Analysis Content -->
                                    <Border Grid.Row="1" Padding="0">
                                        <Grid>
                                            <!-- Loading state -->
                                            <StackPanel x:Name="AnalysisLoadingStack"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Stretch"
                                                        Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Margin="12">
                                                <TextBlock Text="{Binding AnalysisStatusText, FallbackValue='Analyzing...'}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,12"/>
                                                <ProgressBar Height="6"
                                                             Value="{Binding AnalysisProgressValue}"
                                                             Maximum="100"
                                                             Foreground="{StaticResource Brush.Accent.Primary}"
                                                             Background="{StaticResource Brush.Background.Header}"
                                                             BorderThickness="0"/>
                                            </StackPanel>
                                            
                                            <!-- Results state -->
                                            <ScrollViewer x:Name="AnalysisResultsScroll"
                                                          VerticalScrollBarVisibility="Auto"
                                                          Visibility="{Binding AnalysisResults, Converter={StaticResource HasAnalysisResultsConverter}}">
                                                <Border Padding="8">
                                                    <StackPanel>
                                                        <!-- Quality Scores -->
                                                        <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12" Background="{StaticResource Brush.Background.Menu}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Original Quality" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource Brush.Accent.Primary}"/>
                                                                <TextBlock Text="{Binding AnalysisResults.OriginalQualityScore, StringFormat='0/10'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="Improved Quality" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource Brush.Accent.Primary}"/>
                                                                <TextBlock Text="{Binding AnalysisResults.ImprovedQualityScore, StringFormat='0/10', TargetNullValue='-'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.State.Success}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Hallucination Check -->
                                                    <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12" Background="{StaticResource Brush.Background.Menu}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Hallucination Check:" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource Brush.Accent.Primary}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding AnalysisResults.HallucinationCheck, TargetNullValue='Unknown', FallbackValue='Unknown'}" FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}" Margin="6,0,0,0"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Issues -->
                                                    <ItemsControl ItemsSource="{Binding AnalysisResults.Issues}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0" Background="{StaticResource Brush.Background.Menu}">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Category}" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource Brush.Accent.Primary}"/>
                                                                            <Border Background="{StaticResource Brush.Background.Header}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                                                                <TextBlock Text="{Binding Severity}" FontSize="9" Foreground="{StaticResource Brush.Text.Tertiary}"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="9" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                        <TextBlock Grid.Row="2" Text="{Binding Fix, StringFormat='Fixed: {0}'}" FontSize="9" Foreground="{StaticResource Brush.State.Success}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Recommendations -->
                                                    <ItemsControl ItemsSource="{Binding AnalysisResults.Recommendations}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource Brush.Border.Accent}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0" Background="{StaticResource Brush.Background.Menu}">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock Text="{Binding Action}" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource Brush.Accent.Primary}"/>
                                                                        <TextBlock Grid.Row="1" Text="{Binding Details}" FontSize="9" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Improved Requirement -->
                                                    <Border BorderBrush="{StaticResource Brush.State.Success}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,12" Background="{StaticResource Brush.Background.Menu}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Improved Requirement" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource Brush.State.Success}" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="1"
                                                                        Content="Apply to Description"
                                                                        Command="{Binding ApplyImprovedRequirementCommand}"
                                                                        Padding="6,2"
                                                                        FontSize="9"
                                                                        FontWeight="SemiBold"
                                                                        Background="{StaticResource Brush.State.Success}"
                                                                        Foreground="White"
                                                                        BorderBrush="{StaticResource Brush.State.Success}"
                                                                        BorderThickness="1"/>
                                                            </Grid>
                                                            <TextBlock Grid.Row="1" Text="{Binding AnalysisResults.ImprovedRequirement}" FontSize="9" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Freeform Feedback -->
                                                    <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="4" Padding="8" Background="{StaticResource Brush.Background.Menu}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="Analysis Notes" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource Brush.Accent.Primary}"/>
                                                            <TextBlock Grid.Row="1" Text="{Binding AnalysisResults.FreeformFeedback, TargetNullValue='No additional notes'}" FontSize="9" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                    </StackPanel>
                                                </Border>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Requirement editor modal overlay -->
                            <Border Grid.ColumnSpan="2"
                                    Background="#99000000"
                                    Visibility="{Binding IsRequirementEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Panel.ZIndex="200">
                                <Grid>
                                    <Border Background="{StaticResource Brush.Background.Menu}"
                                            BorderBrush="{StaticResource Brush.Border.Accent}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            MaxWidth="1100"
                                            MaxHeight="760"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="3*"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="2*"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Requirement Editor"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="{StaticResource Brush.Accent.Primary}"/>
                                                    <TextBlock Text="Description and support tables can be edited here in one place."
                                                               Margin="0,2,0,0"
                                                               FontSize="10"
                                                               Foreground="{StaticResource Brush.Text.Tertiary}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="X"
                                                        Command="{Binding CloseRequirementEditorCommand}"
                                                        Width="28"
                                                        Height="28"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{StaticResource Brush.Text.Secondary}"
                                                        ToolTip="Cancel and close editor."/>
                                            </Grid>

                                            <Border Grid.Row="2"
                                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8"
                                                    Background="{StaticResource Brush.Background.Header}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="6"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Description"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Brush.Accent.Primary}"/>
                                                    <TextBox Grid.Row="2"
                                                             Text="{Binding RequirementEditorDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Auto"
                                                             MinHeight="180"
                                                             Padding="6,4"
                                                             Foreground="{StaticResource Brush.Text.Primary}"
                                                             Background="{StaticResource Brush.Background.Menu}"
                                                             BorderBrush="{StaticResource Brush.Border.Subtle}"/>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="4"
                                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8"
                                                    Background="{StaticResource Brush.Background.Header}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="6"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Support Tables"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Brush.Accent.Primary}"/>
                                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding RequirementEditorTables}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4"
                                                                            Padding="8"
                                                                            Margin="0,0,0,8"
                                                                            Background="{StaticResource Brush.Background.Menu}">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="6"/>
                                                                                <RowDefinition Height="*"/>
                                                                            </Grid.RowDefinitions>
                                                                            <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                     FontWeight="SemiBold"
                                                                                     Foreground="{StaticResource Brush.Accent.Primary}"
                                                                                     Background="{StaticResource Brush.Background.Header}"
                                                                                     BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                                                     Padding="4,2"/>
                                                                            <TextBox Grid.Row="2"
                                                                                     Text="{Binding TableText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                     AcceptsReturn="True"
                                                                                     TextWrapping="NoWrap"
                                                                                     VerticalScrollBarVisibility="Auto"
                                                                                     HorizontalScrollBarVisibility="Auto"
                                                                                     MinHeight="80"
                                                                                     FontFamily="Consolas"
                                                                                     FontSize="11"
                                                                                     Foreground="{StaticResource Brush.Text.Secondary}"
                                                                                     Background="{StaticResource Brush.Background.Header}"
                                                                                     BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                                                     Padding="4,3"
                                                                                     ToolTip="Edit table cells as tab-delimited rows. One row per line."/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Row="6"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <Button Content="Cancel"
                                                        Command="{Binding CloseRequirementEditorCommand}"
                                                        Margin="0,0,8,0"
                                                        Padding="12,5"
                                                        MinWidth="90"
                                                        Background="{StaticResource Brush.Background.Header}"
                                                        Foreground="{StaticResource Brush.Text.Secondary}"
                                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                        BorderThickness="1"/>
                                                <Button Content="Update Requirement"
                                                        Command="{Binding UpdateRequirementFromEditorCommand}"
                                                        Padding="12,5"
                                                        MinWidth="140"
                                                        FontWeight="SemiBold"
                                                        Background="{StaticResource Brush.Background.Pill.Selected}"
                                                        Foreground="{StaticResource Brush.Accent.Primary}"
                                                        BorderBrush="{StaticResource Brush.Border.Accent}"
                                                        BorderThickness="1"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    </TabItem>

                    <!-- Test Case Tab -->
                    <TabItem Header="Test Case">
                        <Border
                            BorderBrush="{StaticResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Background="{StaticResource Brush.Background.Menu}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="2*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Test Case"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Accent.Primary}"/>
                                <Button Grid.Column="1"
                                        Content="LLM Analyze"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Brush.Background.Pill.Selected}"
                                        Foreground="{StaticResource Brush.Accent.Primary}"
                                        BorderBrush="{StaticResource Brush.Border.Accent}"
                                        BorderThickness="1"/>
                            </Grid>

                            <Border Grid.Row="2"
                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="{StaticResource Brush.Background.Menu}"
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <WrapPanel Grid.Row="0">
                                        <Border Background="{StaticResource Brush.Background.Header}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="12" Margin="0,0,8,0" Padding="8,3">
                                            <TextBlock Text="{Binding CurrentRequirement.Item, StringFormat=Linked Requirement: {0}, TargetNullValue=Linked Requirement: (not set), FallbackValue=Linked Requirement: (not set)}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11"/>
                                        </Border>
                                        <Border Background="{StaticResource Brush.Background.Header}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="12" Margin="0,0,8,0" Padding="8,3">
                                            <TextBlock Text="{Binding CurrentRequirement.GeneratedTestCases.Count, StringFormat=Cases: {0}, TargetNullValue=Cases: 0, FallbackValue=Cases: 0}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11"/>
                                        </Border>
                                    </WrapPanel>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="4" Padding="8" Background="{StaticResource Brush.Background.Header}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Test Case List" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                                <ListBox Grid.Row="2"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{StaticResource Brush.Text.Secondary}"
                                                         ItemsSource="{Binding CurrentRequirement.GeneratedTestCases}"
                                                         SelectedItem="{Binding SelectedTestCase, Mode=TwoWay}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Id, TargetNullValue=(no id)}"/>
                                                                <Run Text=" - "/>
                                                                <Run Text="{Binding Name, TargetNullValue=(unnamed test case)}"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="4" Padding="8" Background="{StaticResource Brush.Background.Header}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="6"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Test Case Details" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                                <TextBlock Grid.Row="2" Text="{Binding SelectedTestCase.Name, TargetNullValue=(select a test case)}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text.Secondary}"/>
                                                <TextBox Grid.Row="4"
                                                         Text="{Binding SelectedTestCase.TestCaseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=(test case details)}"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         TextWrapping="Wrap"
                                                         Foreground="{StaticResource Brush.Text.Secondary}"
                                                         Background="{StaticResource Brush.Background.Menu}"
                                                         BorderBrush="{StaticResource Brush.Border.Subtle}"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="4"
                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="{StaticResource Brush.Background.Header}"
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Generation / Validation Output" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Primary}"/>
                                    <TextBox Grid.Row="2" Text="Generation status, validation findings, and execution history placeholder." AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text.Secondary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Subtle}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    </TabItem>
                </TabControl>

                <!-- Bottom global Jama Object lifecycle + navigation area -->
                <Border Grid.Row="4"
                        Background="{StaticResource Brush.Background.Menu}"
                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Jama Object Navigation"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Accent.Primary}"/>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Unstaged edits are saved locally and not pushed to Jama."
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Tertiary}"
                                           Margin="0,0,14,0"/>

                                <Button Content="◀"
                                        Command="{Binding PreviousRequirementCommand}"
                                    Width="30"
                                    Height="24"
                                        Margin="0,0,6,0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Background="{StaticResource Brush.Background.Header}"
                                    Foreground="{StaticResource Brush.Accent.Primary}"
                                    BorderBrush="{StaticResource Brush.Border.Accent}"
                                    BorderThickness="1"
                                        ToolTip="Previous Jama object"/>

                                <Grid Width="320"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center">
                                    <ToggleButton x:Name="WorkshopNavDropdownButton"
                                                  Height="30"
                                                  Background="{StaticResource Brush.Background.Header}"
                                                  BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                  BorderThickness="1"
                                                  Foreground="{StaticResource Brush.Text.Primary}"
                                                  Padding="8,4"
                                                  HorizontalContentAlignment="Stretch"
                                                  ToolTip="Select a Jama object">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding SelectedRequirement.Item, TargetNullValue=Select Jama object}"/>
                                                <Run Text=" - "/>
                                                <Run Text="{Binding SelectedRequirement.Name}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1"
                                                       Text="▼"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Brush.Accent.Primary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=WorkshopNavDropdownButton}" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="180"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </ToggleButton>

                                    <Popup IsOpen="{Binding IsChecked, ElementName=WorkshopNavDropdownButton, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=WorkshopNavDropdownButton}"
                                           Placement="Bottom"
                                           AllowsTransparency="True"
                                           PopupAnimation="Slide"
                                           StaysOpen="False">
                                        <Border Background="{StaticResource Brush.Background.Menu}"
                                                BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                MinWidth="{Binding ActualWidth, ElementName=WorkshopNavDropdownButton}"
                                                MaxHeight="340">
                                            <ListBox ItemsSource="{Binding Requirements}"
                                                     SelectedItem="{Binding SelectedRequirement, Mode=TwoWay}"
                                                     SelectionChanged="WorkshopNavList_SelectionChanged"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Foreground="{StaticResource Brush.Text.Primary}"
                                                     ScrollViewer.CanContentScroll="True"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                     VirtualizingPanel.ScrollUnit="Item"
                                                     MaxHeight="320">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock TextTrimming="CharacterEllipsis"
                                                                   Padding="6,4">
                                                            <Run Text="{Binding Item}"/>
                                                            <Run Text=" - "/>
                                                            <Run Text="{Binding Name}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <Button Content="▶"
                                        Command="{Binding NextRequirementCommand}"
                                    Width="30"
                                    Height="24"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Background="{StaticResource Brush.Background.Header}"
                                    Foreground="{StaticResource Brush.Accent.Primary}"
                                    BorderBrush="{StaticResource Brush.Border.Accent}"
                                    BorderThickness="1"
                                        ToolTip="Next Jama object"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="Requirement Extraction">
            <Grid Margin="8">
                <Border BorderBrush="{StaticResource Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Background="{StaticResource Brush.Background.Menu}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Requirement Extraction"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="{StaticResource Brush.Accent.Primary}"/>
                                <TextBlock Text="Analyze source documents, extract requirement candidates, and complete qualification review."
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.Text.Tertiary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Search for Attachments"
                                        Command="{Binding SearchAttachmentsCommand}"
                                        Margin="0,0,8,0"
                                        Padding="10,4"
                                        FontSize="11"
                                        Background="{StaticResource Brush.Background.Pill.Selected}"
                                        Foreground="{StaticResource Brush.Accent.Primary}"
                                        BorderBrush="{StaticResource Brush.Border.Accent}"
                                        BorderThickness="1"/>
                                <Button Content="Export Logs"
                                    Command="{Binding ExportExtractionLogsCommand}"
                                    Margin="0,0,8,0"
                                    Padding="10,4"
                                    FontSize="11"
                                    Background="{StaticResource Brush.Background.Header}"
                                    Foreground="{StaticResource Brush.Text.Secondary}"
                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                    BorderThickness="1"/>
                                <Button Content="Cancel"
                                        Command="{Binding CancelAttachmentScraperCommand}"
                                        Padding="10,4"
                                        FontSize="11"
                                        Background="{StaticResource Brush.Background.Header}"
                                        Foreground="{StaticResource Brush.Text.Secondary}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                        BorderThickness="1"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2"
                                BorderBrush="{StaticResource Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="{StaticResource Brush.Background.Header}"
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="560"
                                      VerticalAlignment="Center">
                                    <ToggleButton x:Name="ExtractionAttachmentDropdownButton"
                                                  Height="30"
                                                  Background="{StaticResource Brush.Background.Header}"
                                                  BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                  BorderThickness="1"
                                                  Foreground="{StaticResource Brush.Text.Primary}"
                                                  Padding="8,4"
                                                  HorizontalContentAlignment="Stretch"
                                                  ToolTip="Analyze Source Document">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding SelectedScraperAttachment.DisplayName, TargetNullValue=Select Source Document}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.Text.Primary}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="▼"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Brush.Accent.Primary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=ExtractionAttachmentDropdownButton}" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="180"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </ToggleButton>

                                    <Popup IsOpen="{Binding IsChecked, ElementName=ExtractionAttachmentDropdownButton, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=ExtractionAttachmentDropdownButton}"
                                           Placement="Bottom"
                                           AllowsTransparency="True"
                                           PopupAnimation="Slide"
                                           StaysOpen="False">
                                        <Border Background="{StaticResource Brush.Background.Menu}"
                                                BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                MinWidth="{Binding ActualWidth, ElementName=ExtractionAttachmentDropdownButton}"
                                                MaxHeight="340">
                                            <ListBox ItemsSource="{Binding AvailableScraperAttachments}"
                                                     SelectedItem="{Binding SelectedScraperAttachment, Mode=TwoWay}"
                                                     SelectionChanged="ExtractionAttachmentList_SelectionChanged"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Foreground="{StaticResource Brush.Text.Primary}"
                                                     ScrollViewer.CanContentScroll="True"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                     VirtualizingPanel.ScrollUnit="Item"
                                                     MaxHeight="320">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Padding="6,4"
                                                                   Foreground="{StaticResource Brush.Text.Primary}"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <Button Grid.Column="1"
                                        Content="Extract Candidates"
                                        Command="{Binding ScrapeSelectedAttachmentCommand}"
                                        Margin="10,0,0,0"
                                        Padding="10,4"
                                        FontSize="11"
                                        Background="{StaticResource Brush.Background.Pill.Selected}"
                                        Foreground="{StaticResource Brush.Accent.Primary}"
                                        BorderBrush="{StaticResource Brush.Border.Accent}"
                                        BorderThickness="1"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="4"
                                BorderBrush="{StaticResource Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Background="{StaticResource Brush.Background.Menu}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding AttachmentScraperStatusText}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Accent.Primary}"/>

                                <TextBlock Grid.Row="2"
                                           Text="{Binding AttachmentScraperSummary}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"/>

                                <TextBlock Grid.Row="4"
                                           Text="{Binding ExtractionOverallLabel}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"/>

                                <ProgressBar Grid.Row="6"
                                             Height="8"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ExtractionOverallProgress}"
                                             Foreground="{StaticResource Brush.Accent.Primary}"
                                             Background="{StaticResource Brush.Background.Header}"
                                             BorderThickness="0"/>

                                <TextBlock Grid.Row="8"
                                           Text="{Binding ExtractionCurrentStepLabel}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"/>

                                <ProgressBar Grid.Row="10"
                                             Height="8"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ExtractionCurrentStepProgress}"
                                             Foreground="{StaticResource Brush.State.Success}"
                                             Background="{StaticResource Brush.Background.Header}"
                                             BorderThickness="0"/>

                                <TextBlock Grid.Row="12"
                                           Text="Analysis Log Output"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Accent.Primary}"/>

                                <TextBox Grid.Row="14"
                                         Text="{Binding AttachmentScraperOutputText}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Foreground="{StaticResource Brush.Text.Secondary}"
                                         Background="{StaticResource Brush.Background.Header}"
                                         BorderBrush="{StaticResource Brush.Border.Subtle}"
                                         Padding="8"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="6"
                                BorderBrush="{StaticResource Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Background="{StaticResource Brush.Background.Header}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Qualification Review"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Accent.Primary}"/>

                                <Button Grid.Column="1"
                                        Content="Add Selected to Workspace"
                                        Command="{Binding ImportScrapedRequirementsCommand}"
                                        Padding="10,4"
                                        FontSize="11"
                                        Background="{StaticResource Brush.Background.Pill.Selected}"
                                        Foreground="{StaticResource Brush.Accent.Primary}"
                                        BorderBrush="{StaticResource Brush.Border.Accent}"
                                        BorderThickness="1"
                                        ToolTip="Import only the checked requirement candidates into this workspace."/>

                                <ListBox Grid.Row="2"
                                         Grid.ColumnSpan="2"
                                         ItemsSource="{Binding ScrapedRequirements}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{StaticResource Brush.Text.Secondary}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Margin="0,0,0,6"
                                                    Padding="8"
                                                    Background="{StaticResource Brush.Background.Menu}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,8,0"/>
                                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}">
                                                        <Run Text="{Binding Requirement.Item, TargetNullValue=REQ}"/>
                                                        <Run Text=" - "/>
                                                        <Run Text="{Binding Requirement.Name, TargetNullValue=(untitled)}"/>
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Requirement.Description}"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="48"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource Brush.Text.Secondary}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>


    </Grid>
</UserControl>
