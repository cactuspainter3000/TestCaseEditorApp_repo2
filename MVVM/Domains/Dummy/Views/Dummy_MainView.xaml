<UserControl x:Class="TestCaseEditorApp.MVVM.Domains.Dummy.Views.Dummy_MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1100"
             Background="#2B2B2B">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                BorderBrush="#00FF00"
                BorderThickness="2"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12"
                Background="#303030">
            <StackPanel>
                <TextBlock Text="DUMMY DOMAIN SANDBOX"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#00FF00"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="{Binding DisplayText}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="#CCCCCC"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SectionName, StringFormat=Section: {0}}"
                               FontSize="11"
                               Foreground="#AAAAAA"
                               Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding LastUpdated, StringFormat=Updated: {0:HH:mm:ss}}"
                               FontSize="11"
                               Foreground="#888888"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left side: Inputs and commands -->
            <Border Grid.Column="0"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,8,0"
                    Background="#303030">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Requirement Input"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Requirement ID"
                                   Foreground="#CCCCCC"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SandboxRequirementId, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10"
                                 Padding="8"
                                 Background="#1E1E1E"
                                 Foreground="White"
                                 BorderBrush="#666666"/>

                        <TextBlock Text="Requirement Name"
                                   Foreground="#CCCCCC"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SandboxRequirementName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10"
                                 Padding="8"
                                 Background="#1E1E1E"
                                 Foreground="White"
                                 BorderBrush="#666666"/>

                        <TextBlock Text="Requirement Text"
                                   Foreground="#CCCCCC"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SandboxRequirementText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="140"
                                 Margin="0,0,0,14"
                                 Padding="8"
                                 Background="#1E1E1E"
                                 Foreground="White"
                                 BorderBrush="#666666"/>

                        <TextBlock Text="Controls"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   Margin="0,0,0,12"/>

                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Build Prompt"
                                    Command="{Binding BuildPromptCommand}"
                                    Margin="0,0,8,8"
                                    Padding="10,6"
                                    MinWidth="100"/>

                            <Button Content="Test RAG"
                                    Command="{Binding TestRagCommand}"
                                    Margin="0,0,8,8"
                                    Padding="10,6"
                                    MinWidth="100"/>

                            <Button Content="Test Ollama"
                                    Command="{Binding TestOllamaCommand}"
                                    Margin="0,0,8,8"
                                    Padding="10,6"
                                    MinWidth="100"/>

                            <Button Content="Test Parser"
                                    Command="{Binding TestParserCommand}"
                                    Margin="0,0,8,8"
                                    Padding="10,6"
                                    MinWidth="100"/>

                            <Button Content="Full Pipeline"
                                    Command="{Binding TestFullPipelineCommand}"
                                    Margin="0,0,8,8"
                                    Padding="10,6"
                                    MinWidth="110"/>

                            <Button Content="Clear"
                                    Command="{Binding ClearSandboxCommand}"
                                    Margin="0,0,8,8"
                                    Padding="10,6"
                                    MinWidth="90"/>

                            <Button Content="Main"
                                    Command="{Binding TestButtonCommand}"
                                    Margin="0,0,8,8"
                                    Padding="10,6"
                                    MinWidth="90"/>
                            <Button Content="Run Analysis Demo"
        Command="{Binding RunAnalysisDemoCommand}"
        Margin="0,4,0,4"
        MinWidth="140"
        Padding="8,3"
        FontSize="10">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#4A4A4A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#4FC3F7"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#4FC3F7"/>
                                                            <Setter Property="BorderBrush" Value="#81D4FA"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#0288D1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>

                        <TextBlock Text="Shared Message"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   Margin="0,8,0,6"/>

                        <TextBlock Text="{Binding SharedMessage}"
                                   FontSize="11"
                                   Foreground="#DDDDDD"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="Analysis Preview:"
           FontSize="10"
           FontWeight="Bold"
           Foreground="#4FC3F7"
           Margin="0,10,0,4"/>

                        <Border Background="#1E1E1E"
        BorderBrush="#555555"
        BorderThickness="1"
        CornerRadius="4"
        Padding="8"
        MaxHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding AnalysisPreview}"
                   FontSize="9"
                   Foreground="#DDDDDD"
                   TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="Sandbox Status"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   Margin="0,8,0,6"/>

                        <TextBlock Text="{Binding SandboxStatus}"
                                   Foreground="#FFD966"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Timing"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   Margin="0,8,0,6"/>

                        <TextBlock Text="{Binding SandboxTiming}"
                                   Foreground="#9CDCFE"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right side: Outputs -->
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#555555"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,8"
                        Background="#303030">
                    <DockPanel>
                        <TextBlock Text="Prompt Preview"
                                   DockPanel.Dock="Top"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SandboxPrompt, UpdateSourceTrigger=PropertyChanged}"
         AcceptsReturn="True"
         VerticalScrollBarVisibility="Auto"
         HorizontalScrollBarVisibility="Auto"
         TextWrapping="Wrap"
         MinHeight="160"
         Margin="0,6,0,6"
         FontFamily="Consolas"
         FontSize="12"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1"
                        BorderBrush="#555555"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,8"
                        Background="#303030">
                    <DockPanel>
                        <TextBlock Text="Raw Stream"
                                   DockPanel.Dock="Top"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SandboxRawStream}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#1E1E1E"
                                 Foreground="#DCDCDC"
                                 BorderBrush="#666666"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2"
                        BorderBrush="#555555"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,8"
                        Background="#303030">
                    <DockPanel>
                        <TextBlock Text="Final Response"
                                   DockPanel.Dock="Top"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SandboxFinalResponse, UpdateSourceTrigger=PropertyChanged}"
         AcceptsReturn="True"
         VerticalScrollBarVisibility="Auto"
         HorizontalScrollBarVisibility="Auto"
         TextWrapping="Wrap"
         MinHeight="120"
         Margin="0,6,0,6"
         FontFamily="Consolas"
         FontSize="12"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="3"
                        BorderBrush="#555555"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Background="#303030">
                    <DockPanel>
                        <TextBlock Text="Parsed Result / Diagnostics"
                                   DockPanel.Dock="Top"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SandboxParsedResult}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#1E1E1E"
                                 Foreground="#DCDCDC"
                                 BorderBrush="#666666"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>