<UserControl x:Class="TestCaseEditorApp.MVVM.Domains.Dashboard.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#1E1E1E"
             Foreground="#DDDDDD">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
            <!-- Title -->
            <TextBlock Text="Test Case Editor App"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#FF8C00"
                       TextAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Main Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Create Workshop -->
                <Button Grid.Column="0"
                        Command="{Binding CreateWorkshopCommand}"
                        Padding="20,40"
                        Background="#FF8C00"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="✨ Create Workshop" TextAlignment="Center" FontSize="18" Margin="0,0,0,8"/>
                        <TextBlock Text="Start a new workshop" TextAlignment="Center" FontSize="12" Foreground="#E8E8E8"/>
                    </StackPanel>
                </Button>

                <!-- Open Workshop -->
                <Button Grid.Column="2"
                        Command="{Binding OpenWorkshopCommand}"
                        Padding="20,40"
                        Background="#555555"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderBrush="#777777"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📁 Open Workshop" TextAlignment="Center" FontSize="18" Margin="0,0,0,8"/>
                        <TextBlock Text="Open existing workshop" TextAlignment="Center" FontSize="12" Foreground="#E8E8E8"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Separator -->
            <Rectangle Height="1" Fill="#555555" Margin="0,40,0,40"/>

            <!-- Theme Selection -->
            <TextBlock Text="Choose Theme" FontSize="14" FontWeight="Bold" Foreground="#BBBBBB" Margin="0,0,0,12"/>
            
            <ItemsControl ItemsSource="{Binding AvailableThemes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Name}"
                                Padding="12,8"
                                Margin="4"
                                Background="#2D2D2D"
                                Foreground="#DDDDDD"
                                BorderBrush="#555555"
                                BorderThickness="1"
                                Cursor="Hand">
                            <TextBlock Text="{Binding Name}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11"
                       Foreground="#AFAFAF"
                       TextAlignment="Center"
                       Margin="0,40,0,0"
                       TextWrapping="Wrap"/>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True"
                        Height="2"
                        Background="Transparent"
                        Foreground="#FF8C00"
                        Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
