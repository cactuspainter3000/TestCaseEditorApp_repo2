<UserControl x:Class="TestCaseEditorApp.MVVM.Domains.Dashboard.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#1E1E1E"
             Foreground="#DDDDDD">
    <Grid>
        <Button Content="⚙"
                Command="{Binding OpenSettingsCommand}"
                Width="36"
                Height="36"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                FontSize="16"
                FontWeight="Bold"
                ToolTip="Open Settings"
                Background="#3C3C3C"
                Foreground="White"
                BorderBrush="#666666"
                BorderThickness="1"
                Cursor="Hand"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
            <!-- Title -->
            <TextBlock Text="Test Case Editor App"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#FF8C00"
                       TextAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Main Buttons -->
            <Button Command="{Binding CreateWorkshopCommand}"
                    Padding="20,40"
                    Background="#FF8C00"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    Cursor="Hand"
                    MinWidth="360"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="✨ Create Workshop" TextAlignment="Center" FontSize="18" Margin="0,0,0,8"/>
                    <TextBlock Text="Start a new workshop" TextAlignment="Center" FontSize="12" Foreground="#E8E8E8"/>
                </StackPanel>
            </Button>

            <!-- Separator -->
            <Rectangle Height="1" Fill="#555555" Margin="0,28,0,16"/>

            <TextBlock Text="Available Workshops"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#FF8C00"
                       Margin="0,0,0,8"/>

            <Border BorderBrush="#555555"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="#252525"
                    Padding="8"
                    MinWidth="700"
                    MaxHeight="200">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding RecentProjects}"
                             SelectedItem="{Binding SelectedRecentProject, Mode=TwoWay}"
                             Background="#1E1E1E"
                             BorderBrush="#3F3F3F"
                             Foreground="#DDDDDD"
                             MinHeight="120">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ProjectName}"
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LastModifiedText}"
                                               Foreground="#9A9A9A"
                                               FontSize="11"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="0"
                               Text="No workshops found yet. Use Browse to open one."
                               Foreground="#888888"
                               FontStyle="Italic"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecentProjects}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Open Selected Workshop"
                            Command="{Binding OpenSelectedWorkshopCommand}"
                                Padding="14,8"
                                Margin="0,0,10,0"
                                Background="#FF8C00"
                                Foreground="White"
                                FontWeight="SemiBold"
                                IsEnabled="{Binding HasSelectedRecentProject}"/>

                        <Button Content="Browse..."
                                Command="{Binding OpenWorkshopCommand}"
                                Padding="14,8"
                                Background="#555555"
                                Foreground="White"
                                BorderBrush="#777777"
                                BorderThickness="1"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Use the settings gear in the upper-right to configure app preferences."
                       FontSize="12"
                       Foreground="#BBBBBB"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,12,0,0"/>

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11"
                       Foreground="#AFAFAF"
                       TextAlignment="Center"
                       Margin="0,20,0,0"
                       TextWrapping="Wrap"/>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True"
                        Height="2"
                        Background="Transparent"
                        Foreground="#FF8C00"
                        Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
