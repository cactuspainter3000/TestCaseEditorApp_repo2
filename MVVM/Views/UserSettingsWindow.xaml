<Window x:Class="TestCaseEditorApp.MVVM.Views.UserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Application Settings"
        Height="720"
        Width="860"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background.Menu}"
        Foreground="{StaticResource Brush.Text.Primary}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Configure user-level credentials and model preferences"
                   Foreground="{StaticResource Brush.Text.Primary}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <TabControl Grid.Row="1"
                    Margin="0,0,0,12"
                    Background="{StaticResource Brush.Background.Menu}"
                    BorderBrush="{StaticResource Brush.Border.Default}"
                    SelectedIndex="{Binding SelectedSettingsTabIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <TabItem Header="Jama">
                <Grid Margin="12" Background="{StaticResource Brush.Background.Menu}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding JamaBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Client ID" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding JamaClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Client Secret" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding JamaClientSecret, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <Button Grid.Row="3" Grid.Column="1"
                            Content="Set and Test Jama Connection"
                            Width="230"
                            HorizontalAlignment="Left"
                            Command="{Binding TestJamaConnectionCommand}"/>
                </Grid>
            </TabItem>

            <TabItem Header="AnythingLLM">
                <Grid Margin="12" Background="{StaticResource Brush.Background.Menu}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AnythingLlmBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AnythingLlmApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <Button Grid.Row="2" Grid.Column="1"
                            Content="Set and Test AnythingLLM"
                            Width="220"
                            HorizontalAlignment="Left"
                            Command="{Binding TestAnythingLlmConnectionCommand}"/>
                </Grid>
            </TabItem>

            <TabItem Header="Ollama Models">
                <Grid Margin="12" Background="{StaticResource Brush.Background.Menu}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Chat model" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding OllamaModels}"
                              SelectedItem="{Binding SelectedChatModel, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Embedding model" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding OllamaModels}"
                              SelectedItem="{Binding SelectedEmbeddingModel, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              Margin="0,0,0,8"/>

                    <Button Grid.Row="2" Grid.Column="1"
                            Content="Refresh Ollama Models"
                            Width="190"
                            HorizontalAlignment="Left"
                            Command="{Binding RefreshOllamaModelsCommand}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Diagnostics">
                <Grid Margin="12" Background="{StaticResource Brush.Background.Menu}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Requirements Analysis Diagnostics"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               Margin="0,0,0,8"/>

                    <CheckBox Grid.Row="1" Grid.Column="0"
                              Content="Enable Requirements Analysis Snapshot Logging"
                              IsChecked="{Binding EnableRequirementsAnalysisSnapshot, UpdateSourceTrigger=PropertyChanged}"
                              Foreground="{StaticResource Brush.Text.Primary}"
                              VerticalAlignment="Top"
                              Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Setting changes are persisted when you click Save."
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               Margin="20,0,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.State.Error}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save"
                    Width="110"
                    Margin="0,0,8,0"
                    Command="{Binding SaveAsyncCommand}"/>
            <Button Content="Cancel"
                    Width="110"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
