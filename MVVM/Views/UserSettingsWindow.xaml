<Window x:Class="TestCaseEditorApp.MVVM.Views.UserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Application Settings"
        Height="720"
        Width="860"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background.Menu}"
        Foreground="{StaticResource Brush.Text.Primary}">
    
    <!-- Import resource dictionary for button styles -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Configure user-level credentials and model preferences"
                   Foreground="{StaticResource Brush.Accent.Primary}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <TabControl Grid.Row="1"
                    Margin="0,0,0,16"
                    Background="{StaticResource Brush.Background.Menu}"
                    BorderBrush="{StaticResource Brush.Border.Default}"
                    SelectedIndex="{Binding SelectedSettingsTabIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Foreground="{StaticResource Brush.Text.Primary}">
            <TabItem Header="Jama"
                      Foreground="{StaticResource Brush.Text.Primary}">
                <Grid Margin="12" Background="{StaticResource Brush.Background.Menu}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Margin="0,0,8,12" Foreground="{StaticResource Brush.Text.Primary}" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding JamaBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="8,6" Foreground="{StaticResource Brush.Text.Primary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Default}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Client ID" VerticalAlignment="Center" Margin="0,0,8,12" Foreground="{StaticResource Brush.Text.Primary}" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding JamaClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="8,6" Foreground="{StaticResource Brush.Text.Primary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Default}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Client Secret" VerticalAlignment="Center" Margin="0,0,8,12" Foreground="{StaticResource Brush.Text.Primary}" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding JamaClientSecret, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="8,6" Foreground="{StaticResource Brush.Text.Primary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Default}"/>

                    <Button Grid.Row="3" Grid.Column="1"
                            Content="Set and Test Jama Connection"
                            Width="230"
                            HorizontalAlignment="Left"
                            Padding="12,8"
                            Command="{Binding TestJamaConnectionCommand}"
                            Style="{StaticResource ActionButton}"/>
                </Grid>
            </TabItem>

            <TabItem Header="AnythingLLM"
                      Foreground="{StaticResource Brush.Text.Primary}">
                <Grid Margin="12" Background="{StaticResource Brush.Background.Menu}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Margin="0,0,8,12" Foreground="{StaticResource Brush.Text.Primary}" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AnythingLlmBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="8,6" Foreground="{StaticResource Brush.Text.Primary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Default}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key" VerticalAlignment="Center" Margin="0,0,8,12" Foreground="{StaticResource Brush.Text.Primary}" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AnythingLlmApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="8,6" Foreground="{StaticResource Brush.Text.Primary}" Background="{StaticResource Brush.Background.Menu}" BorderBrush="{StaticResource Brush.Border.Default}"/>

                    <Button Grid.Row="2" Grid.Column="1"
                            Content="Set and Test AnythingLLM"
                            Width="220"
                            HorizontalAlignment="Left"
                            Padding="12,8"
                            Command="{Binding TestAnythingLlmConnectionCommand}"
                            Style="{StaticResource ActionButton}"/>
                </Grid>
            </TabItem>

            <TabItem Header="Ollama Models"
                      Foreground="{StaticResource Brush.Text.Primary}">
                <Grid Margin="12" Background="{StaticResource Brush.Background.Menu}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Chat Model" VerticalAlignment="Center" Margin="0,0,8,12" Foreground="{StaticResource Brush.Text.Primary}" FontWeight="SemiBold"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding OllamaModels}"
                              Text="{Binding SelectedChatModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              Margin="0,0,0,12"
                              Padding="8,6"
                              Foreground="{StaticResource Brush.Text.Primary}"
                              Background="{StaticResource Brush.Background.Menu}"
                              BorderBrush="{StaticResource Brush.Border.Default}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Embedding Model" VerticalAlignment="Center" Margin="0,0,8,12" Foreground="{StaticResource Brush.Text.Primary}" FontWeight="SemiBold"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding OllamaModels}"
                              Text="{Binding SelectedEmbeddingModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              Margin="0,0,0,12"
                              Padding="8,6"
                              Foreground="{StaticResource Brush.Text.Primary}"
                              Background="{StaticResource Brush.Background.Menu}"
                              BorderBrush="{StaticResource Brush.Border.Default}"/>

                    <Button Grid.Row="2" Grid.Column="1"
                            Content="Refresh available models"
                            Width="220"
                            HorizontalAlignment="Left"
                            Padding="12,8"
                            Command="{Binding RefreshOllamaModelsCommand}"
                            Style="{StaticResource ActionButton}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Diagnostics"
                      Foreground="{StaticResource Brush.Text.Primary}">
                <Grid Margin="12" Background="{StaticResource Brush.Background.Menu}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Requirements Analysis Diagnostics"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Accent.Primary}"
                               Margin="0,0,0,12"/>

                    <CheckBox Grid.Row="1" Grid.Column="0"
                              Content="Enable Requirements Analysis Snapshot Logging"
                              IsChecked="{Binding EnableRequirementsAnalysisSnapshot, UpdateSourceTrigger=PropertyChanged}"
                              Foreground="{StaticResource Brush.Text.Primary}"
                              VerticalAlignment="Top"
                              Margin="0,0,0,12"
                              FontSize="14"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Setting changes are persisted when you click Save."
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               Margin="0,0,0,0"
                               FontSize="12"/>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"
                   MinHeight="20"
                   VerticalAlignment="Top">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.State.Error}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save"
                    Width="110"
                    Padding="12,8"
                    Margin="0,0,8,0"
                    Command="{Binding SaveAsyncCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                        <Setter Property="Content" Value="Save"/>
                        <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Primary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                <Setter Property="Content" Value="Save *"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.State.Warning}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Close"
                    Width="110"
                    Padding="12,8"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource ActionButton.Secondary}"/>
        </StackPanel>
    </Grid>
</Window>
