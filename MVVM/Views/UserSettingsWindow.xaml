<Window x:Class="TestCaseEditorApp.MVVM.Views.UserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Application Settings"
        Height="720"
        Width="860"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background.Menu}"
        Foreground="{StaticResource Brush.Text.Primary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DesignSystem.xaml"/>
                <ResourceDictionary Source="/Resources/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Shared style for labelled input rows -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <!-- Shared input box style: dark bg + white text, no native border -->
            <Style x:Key="DarkTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent.Primary}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Window header -->
            <RowDefinition Height="*"/>     <!-- Tab content -->
            <RowDefinition Height="Auto"/>  <!-- Status -->
            <RowDefinition Height="Auto"/>  <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- ── Window header ── -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Background.Menu}"
                BorderBrush="{StaticResource Brush.Accent.Primary}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <TextBlock Text="Configure user-level credentials and model preferences"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- ── Tab control ── -->
        <TabControl Grid.Row="1"
                    Background="{StaticResource Brush.Background.Menu}"
                    BorderBrush="{StaticResource Brush.Border.Default}"
                    BorderThickness="0"
                    SelectedIndex="{Binding SelectedSettingsTabIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Foreground="{StaticResource Brush.Text.Primary}">

            <!-- ── Jama tab ── -->
            <TabItem Header="Jama" Foreground="{StaticResource Brush.Text.Primary}">
                <StackPanel Margin="20,20,20,0">

                    <!-- Base URL -->
                    <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}"/>
                    <Border Background="#2D2D30"
                            BorderBrush="{StaticResource Brush.Border.Default}"
                            BorderThickness="1"
                            Margin="0,0,0,14">
                        <TextBox Text="{Binding JamaBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                    </Border>

                    <!-- Client ID -->
                    <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}"/>
                    <Border Background="#2D2D30"
                            BorderBrush="{StaticResource Brush.Border.Default}"
                            BorderThickness="1"
                            Margin="0,0,0,14">
                        <TextBox Text="{Binding JamaClientId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                    </Border>

                    <!-- Client Secret -->
                    <TextBlock Text="Client Secret" Style="{StaticResource FieldLabel}"/>
                    <Border Background="#2D2D30"
                            BorderBrush="{StaticResource Brush.Border.Default}"
                            BorderThickness="1"
                            Margin="0,0,0,20">
                        <TextBox Text="{Binding JamaClientSecret, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                    </Border>

                    <Button Content="Test Jama Connection"
                            HorizontalAlignment="Left"
                            Padding="16,8"
                            Command="{Binding TestJamaConnectionCommand}"
                            Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </TabItem>

            <!-- ── AnythingLLM tab ── -->
            <TabItem Header="AnythingLLM" Foreground="{StaticResource Brush.Text.Primary}">
                <StackPanel Margin="20,20,20,0">

                    <!-- Base URL -->
                    <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}"/>
                    <Border Background="#2D2D30"
                            BorderBrush="{StaticResource Brush.Border.Default}"
                            BorderThickness="1"
                            Margin="0,0,0,14">
                        <TextBox Text="{Binding AnythingLlmBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                    </Border>

                    <!-- API Key -->
                    <TextBlock Text="API Key" Style="{StaticResource FieldLabel}"/>
                    <Border Background="#2D2D30"
                            BorderBrush="{StaticResource Brush.Border.Default}"
                            BorderThickness="1"
                            Margin="0,0,0,20">
                        <TextBox Text="{Binding AnythingLlmApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                    </Border>

                    <Button Content="Test AnythingLLM Connection"
                            HorizontalAlignment="Left"
                            Padding="16,8"
                            Command="{Binding TestAnythingLlmConnectionCommand}"
                            Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </TabItem>

            <!-- ── Ollama Models tab ── -->
            <TabItem Header="Ollama Models" Foreground="{StaticResource Brush.Text.Primary}">
                <StackPanel Margin="20,20,20,0">

                    <!-- Info banner -->
                    <Border Background="#3C3C3C"
                            BorderBrush="{StaticResource Brush.Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10"
                            Margin="0,0,0,18">
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#CCCCCC"
                                   FontSize="12">
                            <Run Text="Select the Ollama models installed on this machine. Click"/>
                            <Run Text=" Refresh " FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Primary}"/>
                            <Run Text="to load the current list from Ollama."/>
                        </TextBlock>
                    </Border>

                    <!-- Chat Model -->
                    <TextBlock Text="Chat Model" Style="{StaticResource FieldLabel}"/>
                    <Border Background="#2D2D30"
                            BorderBrush="{StaticResource Brush.Border.Default}"
                            BorderThickness="1"
                            Margin="0,0,0,14">
                        <ComboBox ItemsSource="{Binding OllamaModels}"
                                  Text="{Binding SelectedChatModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Background="Transparent"
                                  Foreground="{StaticResource Brush.Text.Primary}"
                                  BorderThickness="0"
                                  Padding="8,6"
                                  FontSize="13"/>
                    </Border>

                    <!-- Embedding Model -->
                    <TextBlock Text="Embedding Model" Style="{StaticResource FieldLabel}"/>
                    <Border Background="#2D2D30"
                            BorderBrush="{StaticResource Brush.Border.Default}"
                            BorderThickness="1"
                            Margin="0,0,0,20">
                        <ComboBox ItemsSource="{Binding OllamaModels}"
                                  Text="{Binding SelectedEmbeddingModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Background="Transparent"
                                  Foreground="{StaticResource Brush.Text.Primary}"
                                  BorderThickness="0"
                                  Padding="8,6"
                                  FontSize="13"/>
                    </Border>

                    <Button Content="Refresh available models"
                            HorizontalAlignment="Left"
                            Padding="16,8"
                            Command="{Binding RefreshOllamaModelsCommand}"
                            Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </TabItem>

            <!-- ── Diagnostics tab ── -->
            <TabItem Header="Diagnostics" Foreground="{StaticResource Brush.Text.Primary}">
                <StackPanel Margin="20,20,20,0">

                    <Border Background="{StaticResource Brush.Background.Menu}"
                            BorderBrush="{StaticResource Brush.Accent.Primary}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,10"
                            Margin="0,0,0,16">
                        <TextBlock Text="Requirements Analysis Diagnostics"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource Brush.Accent.Primary}"/>
                    </Border>

                    <CheckBox Content="Enable Requirements Analysis Snapshot Logging"
                              IsChecked="{Binding EnableRequirementsAnalysisSnapshot, UpdateSourceTrigger=PropertyChanged}"
                              Foreground="{StaticResource Brush.Text.Primary}"
                              FontSize="13"
                              Margin="0,0,0,12"/>

                    <TextBlock Text="Setting changes are persisted when you click Save."
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               FontSize="12"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ── Status message ── -->
        <Border Grid.Row="2"
                Background="#3A3A3A"
                Padding="20,10"
                Margin="0,0,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       MinHeight="18">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.State.Error}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- ── Action buttons ── -->
        <Border Grid.Row="3"
                Background="{StaticResource Brush.Background.Menu}"
                BorderBrush="{StaticResource Brush.Border.Default}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Padding="20,8"
                        Margin="0,0,10,0"
                        Command="{Binding SaveAsyncCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Save"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                    <Setter Property="Content" Value="Save *"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Close"
                        Padding="20,8"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource ActionButton.Secondary}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
